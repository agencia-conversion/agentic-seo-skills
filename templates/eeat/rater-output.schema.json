{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EEAT Rater Output",
  "type": "object",
  "required": ["rater_id", "target", "page_type", "ymyl", "ratings", "issues", "remediation", "rater_narrative", "limitations"],
  "properties": {
    "rater_id": { "type": "string", "pattern": "^rater-[1-3]$" },
    "target": {
      "type": "object",
      "required": ["mode", "value"],
      "properties": {
        "mode": { "enum": ["brain", "url"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "page_type": {
      "enum": ["homepage", "about", "service", "case_study", "article", "author_profile", "contact", "policy", "product_tool", "landing_page"]
    },
    "ymyl": {
      "type": "object",
      "required": ["value", "rationale"],
      "properties": {
        "value": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "ratings": {
      "type": "object",
      "required": ["experience", "expertise", "authoritativeness", "trust"],
      "properties": {
        "experience": { "$ref": "#/definitions/pillar" },
        "expertise": { "$ref": "#/definitions/pillar" },
        "authoritativeness": { "$ref": "#/definitions/pillar" },
        "trust": { "$ref": "#/definitions/pillar" }
      }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/definitions/issue" }
    },
    "reputation_research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_url", "claim", "stance"],
        "properties": {
          "source_url": { "type": "string" },
          "claim": { "type": "string" },
          "stance": { "enum": ["positive", "negative", "neutral"] }
        }
      }
    },
    "risk_flags": { "type": "array", "items": { "type": "string" } },
    "remediation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "what", "why"],
        "properties": {
          "priority": { "enum": ["high", "medium", "low"] },
          "what": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "rater_narrative": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "pillar": {
      "type": "object",
      "required": ["rating", "items"],
      "properties": {
        "rating": { "enum": ["Lowest", "Low", "Medium", "High", "Highest"] },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "state"],
      "properties": {
        "id": { "type": "string" },
        "criterion_label": { "type": "string" },
        "criterion_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "state": { "enum": ["present", "partial", "absent", "unclear", "not_applicable"] },
        "applicability": { "enum": ["required", "expected", "optional", "not_applicable"] },
        "applicability_reason": { "type": "string" },
        "evidence_quote": { "type": "string" },
        "absence_statement": { "type": "string" },
        "source_type": { "enum": ["same_page", "same_site", "external", "source_file", "not_found"] },
        "verification_status": { "enum": ["verified", "self_published", "needs_verification", "not_applicable"] },
        "evidence_locator": { "type": "object" }
      }
    },
    "issue": {
      "type": "object",
      "required": ["severity", "criterion_id", "page_type", "issue_type", "applicability_reason", "recommendation"],
      "properties": {
        "severity": { "enum": ["high", "medium", "low"] },
        "criterion_id": { "type": "string" },
        "page_type": { "enum": ["homepage", "about", "service", "case_study", "article", "author_profile", "contact", "policy", "product_tool", "landing_page"] },
        "issue_type": {
          "enum": [
            "missing_expected_author",
            "unsupported_material_claim",
            "verification_needed",
            "insufficient_reputation_evidence",
            "missing_business_contact",
            "missing_required_policy",
            "outdated_or_undated_editorial_content",
            "missing_responsible_entity",
            "deceptive_or_unsafe_experience"
          ]
        },
        "applicability_reason": { "type": "string" },
        "evidence": { "type": "string" },
        "recommendation": { "type": "string" }
      }
    }
  }
}
