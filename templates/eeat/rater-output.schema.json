{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EEAT Rater Output",
  "type": "object",
  "required": ["rater_id", "target", "ymyl", "ratings", "risk_flags", "remediation", "rater_narrative", "limitations"],
  "properties": {
    "rater_id": { "type": "string", "pattern": "^rater-[1-3]$" },
    "target": {
      "type": "object",
      "required": ["mode", "value"],
      "properties": {
        "mode": { "enum": ["wiki", "url"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "ymyl": {
      "type": "object",
      "required": ["value", "rationale"],
      "properties": {
        "value": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "ratings": {
      "type": "object",
      "required": ["experience", "expertise", "authoritativeness", "trust"],
      "properties": {
        "experience": { "$ref": "#/definitions/pillar" },
        "expertise": { "$ref": "#/definitions/pillar" },
        "authoritativeness": { "$ref": "#/definitions/pillar" },
        "trust": { "$ref": "#/definitions/pillar" }
      }
    },
    "reputation_research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_url", "claim", "stance"],
        "properties": {
          "source_url": { "type": "string" },
          "claim": { "type": "string" },
          "stance": { "enum": ["positive", "negative", "neutral"] }
        }
      }
    },
    "risk_flags": { "type": "array", "items": { "type": "string" } },
    "remediation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "what", "why"],
        "properties": {
          "priority": { "enum": ["high", "medium", "low"] },
          "what": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "rater_narrative": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "pillar": {
      "type": "object",
      "required": ["rating", "items"],
      "properties": {
        "rating": { "enum": ["Lowest", "Low", "Medium", "High", "Highest"] },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "state"],
            "properties": {
              "id": { "type": "string" },
              "state": { "enum": ["present", "partial", "absent", "unclear"] },
              "evidence_quote": { "type": "string" },
              "absence_statement": { "type": "string" },
              "evidence_locator": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
