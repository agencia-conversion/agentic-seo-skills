# Topic Cluster — fonte de verdade operacional
# Ativo após promoção via handoff `approve-cluster`. Rascunho mora em `draft.yaml`.

slug: <kebab-slug>
nome: "<Nome do Cluster>"
area: <slug em brain/editorial.md>
status: active                          # draft | active | retired
context: |
  <2-3 linhas com a tese do cluster, escritas em pt-BR, sem AI-slop.>

pilar:
  slug: <content-slug-em-conteudos>
  keyword: "<keyword do pilar>"
  volume: 880
  volume_source: dataforseo_api

satelites:
  - slug: <content-slug>
    papel: satelite
    status: published                   # planned | drafting | published | retired
    acao: manter                        # manter | revisar | criar | avaliar
    intent: informational               # informational | comparative | commercial | navigational | null
    keyword: "<keyword>"
    volume: 110
    volume_source: dataforseo_api
    note: null

  - slug: <novo-conteudo-planejado>
    papel: satelite
    status: planned
    acao: criar
    intent: informational
    keyword: "<keyword>"
    volume: null
    volume_source: null
    note: "Gap identificado no cluster."

stats:
  total_keywords: 2
  publicados: 1
  planejados: 1

provenance:
  origem: <human-readable origin>
  drafted_at: <YYYY-MM-DD>
  promoted_at: <YYYY-MM-DD>
  promoted_by: <human name>
  source_refs:
    - project/sources/keyword-research/<stamp>-<slug>.normalized.json
    - project/sources/serp/<stamp>-cluster-<slug>.normalized.json

limitations: []
curation_changes: []
