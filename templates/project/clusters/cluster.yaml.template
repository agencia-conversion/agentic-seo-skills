# Topic Cluster — operational source of truth.
# Active after promotion via the `approve-cluster` handoff. Draft lives in `draft.yaml`.
# Schema defined in docs/specs/topic-clusters-contract.md (contract_version: 2).

contract_version: 2
slug: <kebab-slug>
name: "<Cluster Name>"
area: <slug in brain/editorial.md>
status: active                          # drafting | proposed | active | archived
thesis: |
  <2-3 lines with the cluster thesis, no AI-slop.>

pillar:
  slug: <content-slug-in-content>
  keyword: "<pillar keyword>"
  intent: informational                 # informational | transactional | comparative | navigational
  volume: null
  volume_source: null

planned_satellites:
  - slug: <new-planned-content>
    keyword: "<planned keyword>"
    intent: informational
    volume: null
    volume_source: null
    role: satellite
    editorial_status: draft             # draft | in-review | approved | published
    note: "Gap identified in the cluster."

satellite_overrides: {}                 # optional; only when published content needs
                                        # display_title/keyword/editorial_status different from the post title

stats:                                  # regenerated by cluster-sync
  published: 0
  planned: 1
  updated: <YYYY-MM-DD>

provenance:
  created_at: <YYYY-MM-DD>
  created_by: agent
  decision_log: "log.md#cluster-<slug>-<YYYY-MM-DD>"

evidence: []
